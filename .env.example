# Copia questo file come .env e inserisci la tua chiave TMDB
# cp .env.example .env   (su PowerShell: Copy-Item .env.example .env)

TMDB_API_KEY=la_tua_chiave_tmdb_qui
PORT=7000

# URL raggiunto da Stremio (lascia così in locale)
PUBLIC_BASE_URL=http://localhost:7000

# Intervallo di rimescolamento della cache (in ore).
# Usa 0 per rimescolare a ogni richiesta ("Sempre").
SHUFFLE_CACHE_HOURS=6

# 1 = genera locandine custom con badge (sharp). 0 = poster TMDB originali
CUSTOM_POSTERS=1
