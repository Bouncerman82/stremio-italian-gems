# Variabili d'ambiente — copia in `.env` in locale (non committare `.env`)

# Obbligatoria — https://www.themoviedb.org/settings/api
TMDB_API_KEY=la_tua_chiave_tmdb_qui

# Porta locale
PORT=7000

# URL pubblico dell'addon (OBBLIGATORIO in produzione, deve essere HTTPS)
# Esempio Render: https://stremio-italian-gems.onrender.com
PUBLIC_BASE_URL=http://localhost:7000

# Cache discover (secondi). Default 6 ore.
DATA_CACHE_SECONDS=21600

# Poster custom: badge paese verde (1=on, 0=off = solo TMDB).
# Se omesso: OFF in produzione (HTTPS), ON in locale.
CUSTOM_POSTERS=1

# Concorrenza TMDB (default 4 in prod, 8 in locale)
# TMDB_CONCURRENCY=4

# TTL probe totali TMDB in ms (default 300000 in prod)
# TMDB_PROBE_MAX_AGE_MS=300000

# Minimo secondi tra rebuild del pool mix 500
# CONTENT_REFRESH_MIN_SEC=600

# --- Probabilità doppiaggio italiano (titoli stranieri, non cinema IT) ---
# Ranking + densità di blockbuster/animazione/VOD IT tipicamente doppiati.
# IT_DUB_BOOST=1              # 0=off, 1=on (default on)
# IT_DUB_BOOST_STRENGTH=1     # intensità segnali (0.7 soft, 1.3 aggressivo)
# IT_DUB_DENSITY=0.55         # quota target "likely dubbed" in testa (0–1)
# IT_ORIGINAL_DENSIFY_CAP=0.12 # max cinema italiano in testa (default 12%)
# IT_WATCH_OVERSAMPLE=1       # oversample Netflix/Prime/Disney+ IT via TMDB (0=off)
#
# JustWatch Italia (https://www.justwatch.com/it) — popular/trending GraphQL
# JUSTWATCH_IT_BOOST=1              # 0=off (TMDB-only ranking)
# JUSTWATCH_IT_CACHE_SECONDS=86400  # TTL cache indice JW (default 24h)
# JUSTWATCH_IT_PAGE_SIZE=50         # titoli per pagina GQL
# JUSTWATCH_IT_MAX_PAGES=2          # pagine per lista popular/trending
# JUSTWATCH_IT_SEED_LIMIT=35        # TMDB id JW da seedare nel pool (0=solo boost)
